{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI (Port 8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/backend",
      "jinja": true,
      "envFile": "${workspaceFolder}/backend/.env"
    },
    {
      "name": "Frontend: Vite Dev (Port 3000)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"]
    }
  ],
  "compounds": [
    {
      "name": "Fullstack: Backend FastAPI + Frontend Vite",
      "configurations": ["Backend: FastAPI (Port 8000)", "Frontend: Vite Dev (Port 3000)"]
    }
  ]
}
