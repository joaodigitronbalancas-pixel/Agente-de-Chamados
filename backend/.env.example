# =======================================================
# DIGI-TRON TI — GLPI AUTOSCHEDULER (BACKEND PYTHON FASTAPI)
# Arquivo de configuração de exemplo para execução local no Windows
# =======================================================

# URL da API REST oficial do GLPI (instalado no Docker Desktop Windows na porta 8080)
# A interface do usuário fica em http://localhost:8080/front/central.php
# O endpoint da API REST DEVE terminar em /apirest.php
GLPI_BASE_URL="http://localhost:8080/apirest.php"

# App-Token gerado no GLPI em: Configurar > Geral > API
GLPI_APP_TOKEN="SEU_APP_TOKEN_AQUI"

# User-Token (Chave de Acesso Remoto) gerado em: Meu Perfil > Chaves de API
GLPI_USER_TOKEN="SEU_USER_TOKEN_AQUI"

# (Opcional) Autenticação por usuário e senha caso não use user_token
GLPI_USERNAME="joao.leopoldino"
GLPI_PASSWORD=""

# Entidade padrão do GLPI (0 para Entidade Raiz)
GLPI_ENTITY_ID="0"

# Grupo de TI responsável pela atribuição dos chamados (_groups_id_assign)
GLPI_DEFAULT_IT_GROUP_ID="1"
GLPI_DEFAULT_IT_GROUP_NAME="Equipe de TI"

# Intervalo do agendador em segundos para verificação das rotinas (padrão: 20s)
SCHEDULER_INTERVAL_SEC="20"

# Configuração do servidor FastAPI
HOST="0.0.0.0"
PORT="8000"

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
