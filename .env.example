# =======================================================
# DIGI-TRON TI — GLPI AUTOSCHEDULER
# Arquivo de configuração de exemplo para execução local no Windows
# =======================================================

# URL do Backend Local Python FastAPI (Porta 8000)
# Quando informado, o frontend React chama o backend FastAPI local diretamente.
VITE_API_URL="http://localhost:8000"

# URL da aplicação frontend
APP_URL="http://localhost:3000"

# =======================================================
# PARÂMETROS DO GLPI LOCAL (DOCKER DESKTOP WINDOWS)
# =======================================================
# Interface Web do GLPI: http://localhost:8080/front/central.php
# Endpoint REST oficial: http://localhost:8080/apirest.php
GLPI_BASE_URL="http://localhost:8080/apirest.php"
GLPI_URL="http://localhost:8080/apirest.php"

# Tokens de integração gerados no GLPI (salvos em backend/.env)
GLPI_APP_TOKEN="SEU_APP_TOKEN_AQUI"
GLPI_USER_TOKEN="SEU_USER_TOKEN_AQUI"

# Atribuição da Equipe de TI
GLPI_ENTITY_ID="0"
GLPI_DEFAULT_IT_GROUP_ID="1"
GLPI_DEFAULT_IT_GROUP_NAME="Equipe de TI"

# Intervalo em segundos do agendador em segundo plano
SCHEDULER_INTERVAL_SEC="20"
